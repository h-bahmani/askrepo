# Copy this file to .env and fill in your values.

# Any OpenAI-compatible chat-completions API key: OpenAI, Groq, OpenRouter, etc.
ASKREPO_LLM_API_KEY=

# Model name as understood by your chosen provider.
ASKREPO_LLM_MODEL=gpt-4o-mini

# Leave unset for OpenAI itself. Set to switch providers, e.g.:
#   https://api.groq.com/openai/v1
#   https://openrouter.ai/api/v1
ASKREPO_LLM_BASE_URL=
